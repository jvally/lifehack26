{
  "name": "agentready-coach-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "check:release-env": "tsx src/scripts/check-release-env.ts",
    "seed:demo": "node --conditions=react-server --import tsx src/data/seed-demo.ts",
    "seed:release": "npm run check:release-env && npm run seed:demo && npm run seed:demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run e2e:offline",
    "e2e:offline": "tsx scripts/run-playwright.ts offline",
    "e2e:live": "tsx scripts/run-playwright.ts live"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.3",
    "openai": "^7.5.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "^25.0.1",
    "supabase": "^2.39.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
